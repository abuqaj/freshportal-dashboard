# Copy to .env.local (frontend) or set on Railway / Vercel. Never commit real values.

# ── Shared by Vercel and Railway ─────────────────────────────────────────────
# Signs the login token. Must be identical on both sides. Without it the
# backend runs in dev mode with every permission — never leave it empty live.
AUTH_SECRET=change-me
POSTGRES_URL=postgres://...
# Password of the first "admin" account, used only when it is created.
# Without it the password is "admin" — change it right after the first login.
ADMIN_DEFAULT_PASSWORD=

# ── Vercel (frontend) ────────────────────────────────────────────────────────
NEXTAUTH_URL=https://your-app.vercel.app
# Where the browser finds the backend. Locally: http://localhost:8000
NEXT_PUBLIC_RAILWAY_API_URL=https://your-api.up.railway.app

# ── Railway (backend) ────────────────────────────────────────────────────────
# Comma separated origins allowed to call the API. Empty means "*".
ALLOWED_ORIGINS=https://your-app.vercel.app

# FreshPortal login used for Stamgegevens and, unless overridden below,
# for the other systems too.
FRESHPORTAL_URL=https://yourcompany.freshportal.nl
FRESHPORTAL_USERNAME=your_username
FRESHPORTAL_PASSWORD=your_password

# Ecuador (850255). Login falls back to FRESHPORTAL_* when left empty.
ECUADOR_FP_URL=https://850255.freshportal.nl
ECUADOR_FP_USERNAME=
ECUADOR_FP_PASSWORD=
# DFG BatchV1 API — delivery import creates shipments through it
DFG_API_KEY=your_dfg_api_key
DFG_API_BASE_URL=https://850255-api.freshportal.com

# Kenya (850254). Login falls back to FRESHPORTAL_* when left empty.
KENYA_FP_URL=https://850254.freshportal.nl
KENYA_FP_USERNAME=
KENYA_FP_PASSWORD=
KENYA_BI_SYNC_API_KEY=
KENYA_BI_SYNC_API_BASE_URL=

# BI Sync export API — credentials are per tenant: a key from one tenant
# authenticates fine and returns that tenant's data, so each system has its own.
BI_SYNC_API_KEY=your_bi_sync_key
BI_SYNC_API_BASE_URL=https://850255-api.freshportal.com
# Test tenant (850255test). New Products reads its product list from this
# export; without the key it falls back to reading the portal in a browser.
TEST_BI_SYNC_API_KEY=your_test_bi_sync_key
TEST_BI_SYNC_API_BASE_URL=https://850255test-api.freshportal.com
# Only if the test portal's login differs from the main one
TEST_FP_USERNAME=
TEST_FP_PASSWORD=
# How far back the product export asks (days — a product shows up only if it
# was mutated inside the window) and how long a downloaded list is reused (s)
PRODUCT_EXPORT_SINCE_DAYS=760
PRODUCT_EXPORT_MAX_AGE_S=43200

# Floricode (VBN codes)
FLORICODE_USERNAME=your_floricode_user
FLORICODE_PASSWORD=your_floricode_password
# Which VBN assortment groups to mirror from Floricode (comma separated).
# 1 = Snijbloemen / cut flowers (default, ~26k codes), 2 = kamerplanten, 3 = tuinplanten.
VBN_CATALOG_APPLICATIONS=1

# Claude — VBN suggestions, duplicate check, reading supplier forms
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# Lets the laptop holding the knowledge base sync with the Knowledge base
# module. Off unless set to a long random secret.
KB_SYNC_TOKEN=

# Local testing only: exposes an endpoint that hands out an all-permission
# token. Never set on Railway.
DEV_ALLOW_TOKEN_ENDPOINT=
